#!/usr/bin/env python3
"""Opt-in task wrapper. Preserve command output and exit/signal status."""
import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import uuid

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--label', default='Command')
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command[:1] == ['--'] else args.command
if not command:
    parser.error('a command is required after --')
if not args.label or len(args.label) > 160 or any(ord(c) < 32 for c in args.label):
    parser.error('label must be 1–160 printable characters')
executable = os.environ.get('KESTREL_BINARY') or shutil.which('kestrel-island')
task_id = str(uuid.uuid4())
sequence = 0
stop = threading.Event()

def report(state):
    global sequence
    if not executable:
        return
    sequence += 1
    payload = dict(version=1, id=task_id, state=state, label=args.label, seq=sequence)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', prefix='kestrel-task-', suffix='.json', delete=False) as file:
            name = file.name
            json.dump(payload, file)
        subprocess.run([executable, '--task-event-file', name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass  # The hook must never prevent the command from running.
    finally:
        if name:
            try:
                os.unlink(name)
            except FileNotFoundError:
                pass

report('running')
try:
    child = subprocess.Popen(command)  # argv, no shell; inherit stdin/stdout/stderr.
except OSError as error:
    report('failed')
    print(error, file=sys.stderr)
    sys.exit(127)

def heartbeat():
    while not stop.wait(15):
        report('running')

thread = threading.Thread(target=heartbeat, daemon=True)
thread.start()

def forward(signum, frame):
    try:
        child.send_signal(signum)
    except ProcessLookupError:
        pass

for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(sig, forward)
try:
    code = child.wait()
finally:
    stop.set()
    thread.join(timeout=4)
report('completed' if code == 0 else 'failed')
if code < 0:
    signal.signal(-code, signal.SIG_DFL)
    os.kill(os.getpid(), -code)
sys.exit(code)
